{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kawaiko-bot",
  "main": "源/入口.ts",
  "compatibility_date": "2026-08-01",
  // 一部の SDK が node:* を import する．nodejs_compat がそれを Workers 上で用意する．
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Workers Free の cron は 1 アカウント 5 本まで．なので振り分けの理屈は
  // 源/核/予定.ts に置き，cron は 2 本しか無い:
  // - "*/5"   : Discord Gateway の WebSocket (永続体) を保つ番犬
  // - "7 * *" : 毎時のディスパッチャ．日本時間で担当を振り分ける
  //             (独言 / 横槍 / 学習)
  "triggers": {
    "crons": ["*/5 * * * *", "7 * * * *"],
  },
  "vars": {
    // モデルの優先順 (コンマ区切り)．"@cf/..." は Workers AI (API キー不要，
    // 全モデルで分け合う 1 日ぶんの無料枠)，"gemini-..." / "gemma-..." は Gemini API
    // (無料枠はモデルごとに別)．どんな理由で失敗しても次の項目へ手渡し，失敗した
    // モデルだけを 30 分休ませる (源/外界/AI/選択.ts)．無料で使えるものだけを並べてある．
    // 目があるのは gemma-4 / qwen3.8 / llama-4-scout / mistral-small と Gemini API の全部
    // (源/外界/AI/WorkersAI.ts)．画像が添えられた回だけ，それらが前に出る．
    // qwen3.8 は普段は glm より後ろ — 雑談に 27B は要らない．Gemini 側は点呼で測った
    // 速さの順 (3.8 Flash と Gemma 4 31B は 1 言に 30〜50 秒掛かった)．
    "モデル一覧": "@cf/google/gemma-4-26b-a4b-it,@cf/zai-org/glm-4.7-flash,@cf/qwen/qwen3.8-27b,@cf/openai/gpt-oss-120b,@cf/qwen/qwen3-30b-a3b-fp8,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/nvidia/nemotron-3-120b-a12b,@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/aisingapore/gemma-sea-lion-v4-27b-it,@cf/openai/gpt-oss-20b,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemini-3.8-flash,gemma-4-31b-it",
    // 独言の枠が実際に投稿する確率 (0.0-1.0)．
    "独言の確率": "0.75",
    // 横槍の枠が実際に絡む確率 (0.0-1.0)．
    "横槍の確率": "0.7",
    // 名指しへの返事の，利用者ごとの上限．意図して大きい: 人間は到達しない．
    // 暴走したスクリプトや bot 同士のループを止めるためだけのもの．費用は
    // 予算の見張りと Workers AI の無料枠が別に抑えている．
    "時あたりの上限": "500",
    "日あたりの上限": "5000",
    // 月ごとの概算費用の上限 (USD)．コード側の緩い歯止め．
    "月の予算ドル": "100",
    // ---- Discord アプリ ----
    "kawaikoのid": "1540328713248440390",
    // kawaiko の住処: 独り言を落とすチャンネル．
    // 名指しへの返事は，bot が読めるどのチャンネルでも動く．横槍も住処に加えて，
    // 最近人間が喋ったチャンネルへ出ていく (源/振る舞い/横槍返信.ts)．
    "住処のチャンネルid": "1540327628035194911",
    // 横槍を入れないチャンネル (コンマ区切りの id)．告知用など，茶々の要らない場所．
    "横槍しないチャンネルid": "",
    // サーバーの発言を D1 の観測ログへ書くか．毎時の学習がそれを読む．
    // "false" にすると観測を止める (既に覚えたことは残る)．
    "観測するか": "true",
  },
  // 貼られた URL を読みに行くためのブラウザ．Workers Free でも使えるが，
  // ブラウザの時間は 1 日 10 分しかない (核/参照.ts で本数を絞っている)．
  "browser": { "binding": "閲覧" },

  "ai": {
    "binding": "推論",
  },
  "durable_objects": {
    "bindings": [
      { "name": "利用制限帳", "class_name": "利用制限帳" },
      { "name": "予算帳", "class_name": "予算帳" },
      { "name": "Discord接続", "class_name": "Discord接続" },
      // Discord のチャンネルごとに 1 つ．"@kawaiko reset" をそのチャンネルに閉じ込める．
      { "name": "チャンネル記録帳", "class_name": "チャンネル記録帳" },
    ],
  },
  // ---- 長期記憶 (D1) ----
  // データベースがアカウント側に無いと始まらない．いまの CLOUDFLARE_API_TOKEN には
  // D1 の権限が無く `wrangler d1 create` が落ちるので，そのトークンに "D1: Edit" を
  // 足して "Provision" ワークフローを流す (ローカルなら `wrangler d1 create kawaiko-bot`)．
  // 返ってきた database_id を下に貼ってコメントを外せば，以降は deploy が 移行/ を
  // 自動で当てる．それまで記憶まわりは全て no-op で，他の機能は影響を受けない．
  //
  // "d1_databases": [
  //   {
  //     "binding": "記憶のD1",
  //     "database_name": "kawaiko-bot",
  //     "database_id": "<`wrangler d1 create kawaiko-bot` が返す id>",
  //     "migrations_dir": "移行",
  //   },
  // ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserRateLimiter", "BudgetTracker", "DiscordGateway"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChannelMemory"],
    },
    // クラス名を日本語にした。renamed_classes なので保存済みの状態は引き継がれる
    // (予算の集計・利用制限のカウンタ・チャンネルのリセット時刻)。
    {
      "tag": "v3",
      "renamed_classes": [
        { "from": "UserRateLimiter", "to": "利用制限帳" },
        { "from": "BudgetTracker", "to": "予算帳" },
        { "from": "ChannelMemory", "to": "チャンネル記録帳" },
        { "from": "DiscordGateway", "to": "Discord接続" },
      ],
    },
  ],
  // 秘密 (`wrangler secret put` で登録する)．名前が英語なのは GitHub Secrets が
  // 英数字と下線しか許さず，deploy ワークフローがその名前で束ねているため:
  //   DISCORD_BOT_TOKEN / GEMINI_API_KEY / TRIGGER_TOKEN / GH_API_TOKEN
}
