{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kawaiko-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Some SDK dependencies import node:* modules; nodejs_compat provides them on Workers.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Workers Free allows only 5 cron triggers per account, so scheduling logic
  // lives in src/schedule.ts and only two crons exist:
  // - "*/5"   : watchdog that keeps the Discord Gateway WebSocket (DO) alive
  // - "7 * *" : hourly dispatcher -> mutter on designated JST hours (~3/day
  //             after POST_PROBABILITY), uninvited random reply every other
  //             hour (x REPLY_PROBABILITY)
  "triggers": {
    "crons": ["*/5 * * * *", "7 * * * *"],
  },
  "vars": {
    // Comma-separated model preference list. "@cf/..." entries run on Workers
    // AI (no API key, free daily allocation); "gemini-..." entries use the
    // Gemini API. Quota/availability errors fall through to the next entry.
    "KAWAIKO_MODEL": "@cf/google/gemma-4-26b-a4b-it,@cf/zai-org/glm-4.7-flash,gemini-3.5-flash-lite",
    // Probability that a mutter cron slot actually posts (0.0-1.0).
    "POST_PROBABILITY": "0.75",
    // Probability that a reply cron slot actually replies (0.0-1.0).
    "REPLY_PROBABILITY": "0.7",
    // Per-user limits for mention replies.
    "RATE_LIMIT_PER_HOUR": "30",
    "RATE_LIMIT_PER_DAY": "150",
    // Soft monthly cost cap (USD) enforced in code via estimated usage.
    // Also set a hard Workspace spend limit in the Anthropic Console (see README).
    "MONTHLY_BUDGET_USD": "100",
    // ---- Discord application ----
    "DISCORD_APPLICATION_ID": "1540328713248440390",
    // kawaiko's home: the channel it mutters into and randomly replies in.
    // Mentions/DMs work in any channel the bot can read.
    "KAWAIKO_CHANNEL_ID": "1540327628035194911",
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER_RATE_LIMITER", "class_name": "UserRateLimiter" },
      { "name": "BUDGET_TRACKER", "class_name": "BudgetTracker" },
      { "name": "DISCORD_GATEWAY", "class_name": "DiscordGateway" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserRateLimiter", "BudgetTracker", "DiscordGateway"],
    },
  ],
  // Secrets (register with `wrangler secret put`):
  //   DISCORD_BOT_TOKEN
  //   GEMINI_API_KEY
}
