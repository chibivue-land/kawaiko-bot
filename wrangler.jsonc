{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kawaiko-bot",
  "main": "源/入口.ts",
  "compatibility_date": "2026-08-01",
  // Some SDK dependencies import node:* modules; nodejs_compat provides them on Workers.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Workers Free allows only 5 cron triggers per account, so scheduling logic
  // lives in src/schedule.ts and only two crons exist:
  // - "*/5"   : watchdog that keeps the Discord Gateway WebSocket (DO) alive
  // - "7 * *" : hourly dispatcher -> mutter on designated JST hours (~3/day
  //             after POST_PROBABILITY), uninvited random reply every other
  //             hour (x REPLY_PROBABILITY)
  "triggers": {
    "crons": ["*/5 * * * *", "7 * * * *"],
  },
  "vars": {
    // Comma-separated model preference list. "@cf/..." entries run on Workers
    // AI (no API key, free daily allocation); "gemini-..." entries use the
    // Gemini API. Quota/availability errors fall through to the next entry.
    "モデル一覧": "@cf/google/gemma-4-26b-a4b-it,@cf/zai-org/glm-4.7-flash,gemini-3.5-flash-lite",
    // Probability that a mutter cron slot actually posts (0.0-1.0).
    "独言の確率": "0.75",
    // Probability that a reply cron slot actually replies (0.0-1.0).
    "横槍の確率": "0.7",
    // Per-user limits for mention replies. Deliberately huge: humans never
    // hit these; they only stop runaway scripts/bot loops. Cost is bounded by
    // the budget guard and the Workers AI free allocation anyway.
    "時あたりの上限": "500",
    "日あたりの上限": "5000",
    // Soft monthly cost cap (USD) enforced in code via estimated usage.
    // Also set a hard Workspace spend limit in the Anthropic Console (see README).
    "月の予算ドル": "100",
    // ---- Discord application ----
    "kawaikoのid": "1540328713248440390",
    // kawaiko's home: the channel it mutters into and randomly replies in.
    // Mentions/DMs work in any channel the bot can read.
    "住処のチャンネルid": "1540327628035194911",
    // Write every guild message to the D1 observation log (src/memory.ts), which
    // is what the hourly learning pass reads. Set to "false" to stop observing;
    // kawaiko then keeps only what it has already learned.
    "観測するか": "true",
  },
  "ai": {
    "binding": "推論",
  },
  "durable_objects": {
    "bindings": [
      { "name": "利用制限帳", "class_name": "利用制限帳" },
      { "name": "予算帳", "class_name": "予算帳" },
      { "name": "Discord接続", "class_name": "Discord接続" },
      // One instance per Discord channel: "@kawaiko reset" only clears that channel.
      { "name": "チャンネル記録帳", "class_name": "チャンネル記録帳" },
    ],
  },
  // ---- Long-term memory (D1) ----
  // The database has to exist on the account first. The API token in
  // CLOUDFLARE_API_TOKEN currently lacks D1 permissions, so create it by adding
  // "D1: Edit" to that token and running the "Provision" workflow (or, locally,
  // `wrangler d1 create kawaiko-bot`). Then paste database_id below and
  // uncomment — deploy applies migrations/ automatically from there on.
  // Until then every memory feature no-ops and the rest of the bot is unaffected.
  //
  // "d1_databases": [
  //   {
  //     "binding": "記憶のD1",
  //     "database_name": "kawaiko-bot",
  //     "database_id": "<paste from `wrangler d1 create kawaiko-bot`>",
  //     "migrations_dir": "移行",
  //   },
  // ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserRateLimiter", "BudgetTracker", "DiscordGateway"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChannelMemory"],
    },
    // クラス名を日本語にした。renamed_classes なので保存済みの状態は引き継がれる
    // (予算の集計・利用制限のカウンタ・チャンネルのリセット時刻)。
    {
      "tag": "v3",
      "renamed_classes": [
        { "from": "UserRateLimiter", "to": "利用制限帳" },
        { "from": "BudgetTracker", "to": "予算帳" },
        { "from": "ChannelMemory", "to": "チャンネル記録帳" },
        { "from": "DiscordGateway", "to": "Discord接続" },
      ],
    },
  ],
  // Secrets (register with `wrangler secret put`):
  //   DISCORD_BOT_TOKEN
  //   GEMINI_API_KEY
}
